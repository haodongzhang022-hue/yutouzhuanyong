        },
        {
          "qid": "AP1-KP05-Q02",
          "exam": "ap_physics_1",
          "kp_code": "KP05",
          "kp_name": "引力",
          "type": "mc",
          "difficulty": "medium",
          "stem": "A planet has mass M and radius R. The acceleration due to gravity at its surface is g. If the planet's radius doubles while keeping mass the same, what is the new surface gravity?",
          "options": [
            "g/4",
            "g/2",
            "2g",
            "4g"
          ],
          "answer": "A",
          "explanation": "g = GM/R². If R doubles, g' = GM/(2R)² = GM/(4R²) = g/4.",
          "source_ref": "app1-g002"
        }
      ]
