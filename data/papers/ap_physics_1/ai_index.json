    {
      "kp_code": "KP01",
      "kp_name": "运动学",
      "kp_name_en": "Kinematics",
      "module": "力学",
      "count": 3,
      "questions": [
        {
          "qid": "AP1-KP01-Q01",
          "exam": "ap_physics_1",
          "kp_code": "KP01",
          "kp_name": "运动学",
          "type": "mc",
          "difficulty": "medium",
          "stem": "A ball is thrown straight up with an initial speed of 20 m/s. Neglecting air resistance, how long does it take to reach its maximum height? (g = 10 m/s²)",
          "options": [
            "1 s",
            "2 s",
            "3 s",
            "4 s"
          ],
          "answer": "B",
          "explanation": "At maximum height, v=0. Using v=v₀-gt, 0=20-10t, so t=2s.",
          "source_ref": "app1-k001"
        },
        {
          "qid": "AP1-KP01-Q02",
          "exam": "ap_physics_1",
          "kp_code": "KP01",
          "kp_name": "运动学",
          "type": "mc",
          "difficulty": "medium",
          "stem": "A projectile is launched horizontally from a cliff at 15 m/s. If the cliff is 20 m high, how far from the base does it land? (g = 10 m/s², ignore air resistance)",
          "options": [
            "20 m",
            "30 m",
            "40 m",
            "60 m"
          ],
          "answer": "B",
          "explanation": "Time to fall: t=√(2h/g)=√(2×20/10)=2s. Horizontal distance: x=v×t=15×2=30 m.",
          "source_ref": "app1-k004"
        },
        {
          "qid": "AP1-KP01-Q03",
          "exam": "ap_physics_1",
          "kp_code": "KP01",
          "kp_name": "运动学",
          "type": "mc",
          "difficulty": "hard",
          "stem": "An object moves with velocity v = 3t² m/s. What is its acceleration at t = 2 s?",
          "options": [
            "6 m/s²",
            "12 m/s²",
            "3 m/s²",
            "24 m/s²"
          ],
          "answer": "B",
          "explanation": "a = dv/dt = 6t. At t=2s: a = 12 m/s².",
          "source_ref": "app1-k005"
        }
      ]
    },
    {
      "kp_code": "KP02",
      "kp_name": "牛顿动力学",
      "kp_name_en": "Newtonian Dynamics",
      "module": "力学",
      "count": 3,
      "questions": [
        {
          "qid": "AP1-KP02-Q01",
          "exam": "ap_physics_1",
          "kp_code": "KP02",
          "kp_name": "牛顿动力学",
          "type": "mc",
          "difficulty": "easy",
          "stem": "A 2 kg object is pushed with a constant net force of 10 N. What is the magnitude of the object's acceleration?",
          "options": [
            "2 m/s²",
            "5 m/s²",
            "10 m/s²",
            "20 m/s²"
          ],
          "answer": "B",
          "explanation": "Using Newton's 2nd law F=ma, a=F/m=10/2=5 m/s².",
          "source_ref": "app1-k002"
        },
        {
          "qid": "AP1-KP02-Q02",
          "exam": "ap_physics_1",
          "kp_code": "KP02",
          "kp_name": "牛顿动力学",
          "type": "mc",
          "difficulty": "medium",
          "stem": "A 5 kg box is pulled by a horizontal force of 25 N. The coefficient of kinetic friction is 0.2. What is the acceleration? (g = 10 m/s²)",
          "options": [
            "3 m/s²",
            "4 m/s²",
            "5 m/s²",
            "1 m/s²"
          ],
          "answer": "A",
          "explanation": "Friction f=μmg=0.2×5×10=10N. Net force F=25-10=15N. a=F/m=15/5=3 m/s².",
          "source_ref": "app1-d001"
        },
        {
          "qid": "AP1-KP02-Q03",
          "exam": "ap_physics_1",
          "kp_code": "KP02",
          "kp_name": "牛顿动力学",
          "type": "mc",
          "difficulty": "hard",
          "stem": "A block of mass m is on a frictionless incline at angle 30°. What is its acceleration down the incline? (g = 10 m/s²)",
          "options": [
            "3.3 m/s²",
            "5 m/s²",
            "8.7 m/s²",
            "10 m/s²"
          ],
          "answer": "B",
          "explanation": "a = g·sinθ = 10×sin30° = 10×0.5 = 5 m/s².",
          "source_ref": "app1-d002"
        }
      ]
    },
    {
      "kp_code": "KP03",
      "kp_name": "功、能与功率",
      "kp_name_en": "Work Energy and Power",
      "module": "力学",
      "count": 4,
      "questions": [
        {
          "qid": "AP1-KP03-Q01",
          "exam": "ap_physics_1",
          "kp_code": "KP03",
          "kp_name": "功、能与功率",
          "type": "mc",
          "difficulty": "hard",
          "stem": "A block slides down a frictionless incline of height h from rest. At the bottom, it compresses a spring of spring constant k. What is the maximum compression x of the spring?",
          "options": [
            "x = mgh/k",
            "x = √(2mgh/k)",
            "x = 2mgh/k",
            "x = mgh/2k"
          ],
          "answer": "B",
          "explanation": "Energy conservation: mgh = ½kx², so x = √(2mgh/k).",
          "source_ref": "app1-k003"
        },
        {
          "qid": "AP1-KP03-Q02",
          "exam": "ap_physics_1",
          "kp_code": "KP03",
          "kp_name": "功、能与功率",
          "type": "mc",
          "difficulty": "medium",
          "stem": "A 2 kg object is moving at 6 m/s. How much work is needed to stop it?",
          "options": [
            "12 J",
            "18 J",
            "24 J",
            "36 J"
          ],
          "answer": "D",
          "explanation": "Work = ΔKE = ½mv² = ½×2×36 = 36 J.",
          "source_ref": "app1-w001b"
        },
        {
          "qid": "AP1-KP03-Q03",
          "exam": "ap_physics_1",
          "kp_code": "KP03",
          "kp_name": "功、能与功率",
          "type": "mc",
          "difficulty": "medium",
          "stem": "A force of 50 N is applied to push a box 3 m along the floor at an angle of 60° above the horizontal. How much work is done?",
          "options": [
            "50 J",
            "75 J",
            "129 J",
            "150 J"
          ],
          "answer": "B",
          "explanation": "W = F·d·cosθ = 50×3×cos60° = 150×0.5 = 75 J.",
          "source_ref": "app1-w002"
        },
        {
          "qid": "AP1-KP03-Q04",
          "exam": "ap_physics_1",
          "kp_code": "KP03",
          "kp_name": "功、能与功率",
          "type": "mc",
          "difficulty": "medium",
          "stem": "A machine does 5000 J of work in 20 seconds. What is its power output?",
          "options": [
            "100 W",
            "250 W",
            "500 W",
            "1000 W"
          ],
          "answer": "B",
          "explanation": "P = W/t = 5000/20 = 250 W.",
          "source_ref": "app1-p001"
        }
      ]
    },
